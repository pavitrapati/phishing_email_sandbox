# Absolute HOST path to ./data  (REQUIRED — see docs/ARCHITECTURE.md "Job lifecycle")
SANDBOX_HOST_DATA=/media/mrgrin69/D/programming_languages/phishing_email_sandbox/data

# Where the API listens. Keep it on loopback unless you know what you are doing.
SANDBOX_BIND=127.0.0.1
SANDBOX_PORT=8090

# Optional shared secret. If set, callers must send  X-API-Key: <value>
API_KEY=

# Detonation budget
JOB_TIMEOUT_SECONDS=180     # hard wall-clock kill for the whole worker container
DETONATION_SECONDS=45       # budget for the execution phase inside the worker

# Worker resource caps
WORKER_MEMORY=768m
WORKER_CPUS=1.0
WORKER_PIDS_LIMIT=256

MAX_UPLOAD_BYTES=52428800   # 50 MiB

# Set to 1 only after `make build-wine`. Enables real PE detonation under Wine.
ENABLE_WINE=0

LOG_LEVEL=INFO
